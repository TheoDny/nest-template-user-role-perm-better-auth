{
    "name": "nestjs-better-auth-api",
    "version": "0.1.0",
    "private": true,
    "description": "NestJS API with Better Auth, Prisma, organizations, roles, members, and invitations.",
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\" \"*.json\" \"*.md\" --ignore-unknown --no-error-on-unmatched-pattern && prisma format",
        "lint": "eslint \"{src,test}/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:prod": "bun dist/src/main.js",
        "test": "jest --passWithNoTests",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:seed": "prisma db seed",
        "prisma:studio": "prisma studio"
    },
    "dependencies": {
        "@nestjs/common": "^11.2.1",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.2.1",
        "@nestjs/platform-express": "^11.2.1",
        "@nestjs/swagger": "^11.4.7",
        "@prisma/adapter-pg": "^7.9.1",
        "@prisma/client": "^7.9.1",
        "@thallesp/nestjs-better-auth": "^2.7.0",
        "better-auth": "^1.7.1",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.4",
        "dotenv": "^17.4.2",
        "mjml": "^5.4.0",
        "nodemailer": "^9.0.5",
        "pg": "^8.23.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "swagger-ui-express": "^5.0.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@nestjs/cli": "^11.0.24",
        "@nestjs/schematics": "^11.1.0",
        "@nestjs/testing": "^11.2.1",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/mjml": "^4.7.4",
        "@types/node": "^22.20.1",
        "@types/nodemailer": "^6.4.24",
        "@types/supertest": "^6.0.3",
        "eslint": "^9.39.5",
        "jest": "^30.4.2",
        "prettier": "^3.9.6",
        "prisma": "^7.9.1",
        "source-map-support": "^0.5.21",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.12",
        "ts-loader": "^9.6.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.23.12",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.67.0"
    },
    "engines": {
        "bun": ">=1.2.0"
    },
    "packageManager": "bun@1.4.0",
    "trustedDependencies": [
        "@prisma/client",
        "@prisma/engines",
        "prisma",
        "unrs-resolver"
    ]
}